<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Management English</title><style>
*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial;background:#f4f6fa;color:#172033}header{background:#172033;color:#fff;text-align:center;padding:34px 18px}h1{margin:0 0 8px}.sub{opacity:.85}nav{background:#fff;padding:12px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap;position:sticky;top:0;z-index:2}button{border:0;border-radius:10px;padding:11px 15px;font-weight:700;cursor:pointer;background:#e9edf4;color:#172033}.active{background:#172033;color:#fff}main{max-width:900px;margin:22px auto;padding:0 15px}.card{background:#fff;border-radius:18px;padding:20px;margin:14px 0;box-shadow:0 5px 20px #0001}.word{font-size:23px;font-weight:800}.meaning{color:#59657a;margin:5px 0}.ex{direction:ltr;text-align:left;background:#f6f7f9;padding:12px;border-radius:10px;margin:10px 0}.hidden{display:none}.choice{display:block;width:100%;margin:8px 0;text-align:right}.ok{background:#dff5e7}.bad{background:#ffe1e1}.barbg{height:10px;background:#e2e6ed;border-radius:10px}.bar{height:100%;width:0;background:#172033;border-radius:10px}
</style></head><body><header><h1>Management English 🎓</h1><div class="sub">English for University Management Students</div></header><nav><button class="active" onclick="tab('home',this)">الرئيسية</button><button onclick="tab('l1',this)">🟢 Level 1</button><button onclick="tab('l2',this)">🟡 Level 2</button><button onclick="tab('l3',this)">🔴 Level 3</button><button onclick="tab('quiz',this)">📝 Quiz</button></nav><main>
<section id="home"><div class="card"><h2>Welcome 👋</h2><p>تعلم إنجليزي تخصص الإدارة من الأساسيات إلى Business English المتقدم.</p><div class="barbg"><div class="bar" id="bar"></div></div><p id="progress">تقدمك: 0%</p></div><div class="card"><h3>المستويات</h3><p>🟢 Level 1 — أساسيات الإدارة</p><p>🟡 Level 2 — مصطلحات الجامعة والإدارة</p><p>🔴 Level 3 — Business English متقدم</p><p>📝 Quiz — اختبر نفسك</p></div></section>
<section id="l1" class="hidden"><div class="card"><h2>🟢 Management Basics</h2><div id="a1"></div></div></section>
<section id="l2" class="hidden"><div class="card"><h2>🟡 University & Management</h2><div id="a2"></div></div></section>
<section id="l3" class="hidden"><div class="card"><h2>🔴 Advanced Business English</h2><div id="a3"></div></div></section>
<section id="quiz" class="hidden"><div class="card"><h2>📝 Quick Quiz</h2><div id="q"></div><button onclick="next()">السؤال التالي</button><p id="score"></p></div></section>
</main><script>
const d={
a1:[["Manager","مدير","The manager leads the team."],["Employee","موظف","The employee works for the company."],["Team","فريق","Our team has five members."],["Customer","عميل","The customer is satisfied."],["Goal","هدف","The company has a clear goal."],["Meeting","اجتماع","We have a meeting today."],["Task","مهمة","I finished my task."],["Company","شركة","She works for a large company."]],
a2:[["Leadership","القيادة","Good leadership improves teamwork."],["Motivation","التحفيز","Motivation can improve performance."],["Performance","الأداء","The manager evaluated performance."],["Organizational Behavior","السلوك التنظيمي","We study organizational behavior."],["Human Resources","الموارد البشرية","HR manages recruitment."],["Decision Making","اتخاذ القرار","Decision making is a key skill."],["Recruitment","التوظيف","Recruitment is part of HR."],["Job Satisfaction","الرضا الوظيفي","Job satisfaction affects employees."]],
a3:[["Stakeholder","صاحب مصلحة","Managers should understand stakeholder needs."],["Competitive Advantage","ميزة تنافسية","Innovation can create a competitive advantage."],["Strategic Planning","التخطيط الاستراتيجي","Strategic planning supports long-term goals."],["KPI","مؤشر أداء رئيسي","Sales growth is an important KPI."],["Risk Management","إدارة المخاطر","Risk management reduces potential losses."],["ROI","العائد على الاستثمار","The company calculated its ROI."],["Market Share","الحصة السوقية","The company increased its market share."],["Revenue","الإيرادات","Revenue increased this year."]]};
function render(id,arr){document.getElementById(id).innerHTML=arr.map(x=>`<div class="card"><div class="word">${x[0]}</div><div class="meaning">${x[1]}</div><div class="ex">${x[2]}</div><button onclick="speak('${x[0]}')">🔊 اسمع النطق</button></div>`).join("")}
render("a1",d.a1);render("a2",d.a2);render("a3",d.a3);
function speak(t){speechSynthesis.speak(new SpeechSynthesisUtterance(t))}
function tab(id,b){document.querySelectorAll("main section").forEach(x=>x.classList.add("hidden"));document.getElementById(id).classList.remove("hidden");document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));b.classList.add("active")}
const qs=[["What does Manager mean?","مدير",["مدير","موظف","عميل"]],["What does Goal mean?","هدف",["خطة","هدف","نتيجة"]],["What is Leadership?","القيادة",["التدريب","القيادة","الراتب"]],["What does KPI mean?","مؤشر أداء رئيسي",["مؤشر أداء رئيسي","معلومات شخصية","خطة رئيسية"]],["What does Recruitment mean?","التوظيف",["التوظيف","الترقية","الميزانية"]]];let i=0,s=0,answered=false;
function q(){let x=qs[i];document.getElementById("q").innerHTML=`<h3>${i+1}. ${x[0]}</h3>`+x[2].map(a=>`<button class="choice" onclick="ans(this,'${a}','${x[1]}')">${a}</button>`).join("");document.getElementById("score").textContent=`النتيجة: ${s}/${qs.length}`;answered=false}
function ans(b,a,c){if(answered)return;answered=true;if(a===c){b.classList.add("ok");s++}else b.classList.add("bad");document.getElementById("score").textContent=`النتيجة: ${s}/${qs.length}`;let p=Math.round(s/qs.length*100);document.getElementById("bar").style.width=p+"%";document.getElementById("progress").textContent=`تقدمك: ${p}%`;localStorage.setItem("score",s)}
function next(){i=(i+1)%qs.length;q()}s=+localStorage.getItem("score")||0;let p=Math.round(s/qs.length*100);document.getElementById("bar").style.width=p+"%";document.getElementById("progress").textContent=`تقدمك: ${p}%`;q();
</script></body></html>
